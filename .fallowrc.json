{
  // Each plugin is installed as a copy of its own folder, so hooks modules cannot import across plugins.
  // Fallow cannot see that hooks.json loads register.ts, so the hooks files are declared as entry points.
  // draft-pr starts its server script with node, which fallow cannot see either.
  // turn-edits-lib.sh is copied into plugins/code-style/hooks and plugins/tdd/hooks on purpose: each plugin is self-contained.
  // plugin-host/build.ts is run by sync-qwen, sync-pi, sync-opencode and sync-crush, and it writes the entry file that imports targets.ts.
  // plugin-host/opencode-install.ts is run by sync-opencode, and plugin-host/crush-install.ts by sync-crush.
  // design-studio/cli.ts and plugins/ui-design/gallery.ts are run directly with bun.
  // theme/kit-theme.css is not imported: tests/repository.test.sh checks that every plugin page carries a copy of it.
  "ignorePatterns": ["theme/**"],
  "entry": ["design-studio/cli.ts", "plugins/ui-design/gallery.ts","design-studio/*.test.ts", "plugins/*/hooks/register.ts", "plugins/*/hooks/register.tsx", "plugins/*/hooks/run.ts", "plugins/*/hooks/*.test.ts", "plugins/*/server/*.mjs", "plugin-host/build.ts", "plugin-host/opencode-install.ts", "plugin-host/crush-install.ts", "plugin-host/targets.ts", "plugin-host/**/*.test.ts"],
  // Each guards hook module exports decide, and run.ts imports them under distinct aliases.
  "ignoreExports": [{ "file": "plugins/guards/hooks/*.ts", "exports": ["decide"] }],
  "duplicates": {
    // describeRecentMessages is copied between prompt-optimizer and handoff on purpose: plugins must be self-contained.
    // readPlanFiles/readTemplateFiles are copied between brainstorm and draft-pr for the same reason.
    // formatFileStamp and escapeHtml are copied between brainstorm, draft-pr and design.
    // openInBrowser, describeError and resolveProjectPath are copied between brainstorm and design.
    // resolveProjectName, toProjectName, trimText and toSlug are copied between handoff, small-plans, brainstorm and project-notes.
    // NOTE_STORES, resolveStoreRoot and listFilesUnder are copied from project-notes into tidy-notes for the same reason.
    // secret-patterns.ts is copied between handoff and project-notes: secret patterns copied per plugin on purpose; plugins cannot import each other.
    "ignoredClones": [
      "dup:e67f2e0e:2",
      "dup:f469e6dc:2",
      "dup:8038f0a0:2",
      "dup:6e0b87e8:3",
      "dup:af9f93b3:3",
      "dup:51f3f0ab:2",
      "dup:62f2276b:2",
      "dup:45460fbd:3",
      "dup:0f3df041:2",
      "dup:efbf4a15:2",
      "dup:fdb5bdd8:2",
      "dup:577fa913:2",
      "dup:16cd138d:2",
      "dup:beaaf42e:2",
      "dup:8961912e:2",
      "dup:a566d9d3:2"
    ]
  }
}

#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

is_staged_only=false
if [ "${1:-}" = "--staged" ]; then
  is_staged_only=true
fi

should_check() {
  [ "$is_staged_only" = false ] || ! git diff --cached --quiet -- "$@"
}

run_outside_the_commit_index() {
  env -u GIT_INDEX_FILE "$@"
}

is_missing_generated_types() {
  grep -qs "claude-plugin/types" "$1/tsconfig.json" && [ ! -d "$1/.claude-plugin/types" ]
}

for manifest in plugins/*/package.json; do
  plugin_folder="$(dirname "$manifest")"
  should_check "$plugin_folder" || continue
  echo "check: $plugin_folder"
  if [ "$is_staged_only" = true ]; then
    (cd "$plugin_folder" && pnpm exec lint-staged)
  fi
  if is_missing_generated_types "$plugin_folder"; then
    echo "check: skipping the $plugin_folder typecheck, Claude Code has not generated .claude-plugin/types there"
  else
    (cd "$plugin_folder" && pnpm run typecheck)
  fi
  (cd "$plugin_folder" && run_outside_the_commit_index pnpm run test)
done

if should_check notes-viewer; then
  echo "check: notes-viewer"
  (cd notes-viewer && run_outside_the_commit_index go test ./...)
fi

for bun_folder in plugin-host design-studio; do
  should_check "$bun_folder" || continue
  echo "check: $bun_folder"
  run_outside_the_commit_index bun test "$bun_folder"
done

for sync_test in tests/sync-*.test.sh; do
  sync_script="$(basename "$sync_test" .test.sh)"
  should_check "$sync_script" "$sync_test" plugin-host || continue
  echo "check: $sync_test"
  run_outside_the_commit_index bash "$sync_test"
done

if should_check claude-kit-update tests/claude-kit-update.test.sh notes-viewer/claude-notes; then
  echo "check: tests/claude-kit-update.test.sh"
  run_outside_the_commit_index bash tests/claude-kit-update.test.sh
fi

echo "check: tests/repository.test.sh"
run_outside_the_commit_index bash tests/repository.test.sh

echo "check: passed"

#!/usr/bin/env bash
set -euo pipefail

fail() {
  echo "$1" >&2
  exit 1
}

repository_root="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
link_directory="${CLAUDE_KIT_LINK_DIR:-$HOME/.local/bin}"
failed_steps=()

command -v claude >/dev/null || fail "claude-kit-update needs the claude CLI on the PATH."
command -v jq >/dev/null || fail "claude-kit-update needs jq: brew install jq"

has_claude_kit_marketplace() {
  claude plugin marketplace list --json | jq -e '.[] | select(.name == "claude-kit")' >/dev/null
}

link_command() {
  local command_path="$1"
  local link_path="$link_directory/$(basename "$command_path")"
  if [ -e "$link_path" ] && [ ! -L "$link_path" ]; then
    echo "Left $link_path alone: it is a file, not a link."
    return
  fi
  ln -sfn "$command_path" "$link_path"
}

write_profile() {
  local profile_name="$1" are_code_plugins_on are_web_plugins_on
  local settings_path=".claude/settings.local.json"
  case "$profile_name" in
    web) are_code_plugins_on=true; are_web_plugins_on=true ;;
    code) are_code_plugins_on=true; are_web_plugins_on=false ;;
    notes) are_code_plugins_on=false; are_web_plugins_on=false ;;
    *)
      echo "Usage: claude-kit-update profile web|code|notes" >&2
      exit 2
      ;;
  esac
  mkdir -p .claude
  [ -f "$settings_path" ] || echo '{}' > "$settings_path"
  jq --argjson code "$are_code_plugins_on" --argjson web "$are_web_plugins_on" '
    .enabledPlugins = ((.enabledPlugins // {}) + {
      "code-style@claude-kit": $code,
      "tdd@claude-kit": $code,
      "quality-gates@claude-kit": $code,
      "ui-design@claude-kit": $web,
      "vercel@claude-plugins-official": $web,
      "frontend-design@claude-plugins-official": $web
    })' "$settings_path" > "$settings_path.new" \
    || { rm -f "$settings_path.new"; fail "$PWD/$settings_path is not valid JSON; nothing was changed."; }
  mv "$settings_path.new" "$settings_path"
  echo "Wrote the $profile_name profile to $PWD/$settings_path. Start a new Claude Code session here to load it."
}

if [ "${1:-}" = "profile" ]; then
  write_profile "${2:-}"
  exit 0
fi

echo "Pulling $repository_root"
git -C "$repository_root" pull --ff-only || failed_steps+=("pull $repository_root")

if ! has_claude_kit_marketplace; then
  echo "Adding the claude-kit marketplace from $repository_root"
  claude plugin marketplace add "$repository_root"
fi

echo "Updating every marketplace"
claude plugin marketplace update

while IFS=$'\t' read -r plugin_id plugin_scope; do
  echo "Updating $plugin_id"
  claude plugin update "$plugin_id" --scope "$plugin_scope" || failed_steps+=("update $plugin_id")
done < <(claude plugin list --available --json | jq -r '.installed[] | [.id, .scope] | @tsv')

mkdir -p "$link_directory"
link_command "$repository_root/notes-viewer/claude-notes"
link_command "$repository_root/plugins/token-ledger/bin/claude-ledger"
link_command "$repository_root/claude-kit-update"
link_command "$repository_root/claude-kit-doctor"

if [ "${#failed_steps[@]}" -gt 0 ]; then
  printf 'Failed: %s\n' "${failed_steps[@]}" >&2
  exit 1
fi
echo "Done. Start a new Claude Code session to load the updated plugins."

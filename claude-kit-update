#!/usr/bin/env bash
set -euo pipefail

fail() {
  echo "$1" >&2
  exit 1
}

repository_root="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
link_directory="${CLAUDE_KIT_LINK_DIR:-$HOME/.local/bin}"
failed_steps=()

command -v claude >/dev/null || fail "claude-kit-update needs the claude CLI on the PATH."
command -v jq >/dev/null || fail "claude-kit-update needs jq: brew install jq"

has_claude_kit_marketplace() {
  claude plugin marketplace list --json | jq -e '.[] | select(.name == "claude-kit")' >/dev/null
}

move_store_folder() {
  local store="$1" label="$2" override_variable="$3"
  local old="$HOME/.claude/$store" new="$HOME/.local/share/$store" project name left
  if [ -n "${!override_variable+x}" ] || [ -L "$old" ] || [ ! -d "$old" ]; then
    return 0
  fi
  if [ ! -e "$new" ]; then
    mkdir -p "$HOME/.local/share" && mv "$old" "$new" || return 1
    echo "Moved $label to ~/.local/share/$store"
    return 0
  fi
  for project in "$old"/* "$old"/.[!.]* "$old"/..?*; do
    [ -e "$project" ] || [ -L "$project" ] || continue
    name="$(basename "$project")"
    if [ -e "$new/$name" ]; then
      echo "Left ~/.claude/$store/$name: already in ~/.local/share/$store"
    else
      mv "$project" "$new/" || return 1
    fi
  done
  rmdir "$old" 2>/dev/null || true
  if [ -d "$old" ]; then
    left="$(find "$old" -mindepth 1 -maxdepth 1 | wc -l)"
    echo "Left $((left)) items in ~/.claude/$store"
  fi
}

link_command() {
  local command_path="$1"
  local link_path="$link_directory/$(basename "$command_path")"
  if [ -e "$link_path" ] && [ ! -L "$link_path" ]; then
    echo "Left $link_path alone: it is a file, not a link."
    return
  fi
  ln -sfn "$command_path" "$link_path"
}

write_profile() {
  local profile_name="$1"
  local settings_path=".claude/settings.local.json"
  case "$profile_name" in
    code) profile_name=coding ;;
    web) profile_name=ui ;;
    coding|ui|planning|notes) ;;
    *) echo "Usage: claude-kit-update profile coding|ui|planning|notes (aliases: code, web)" >&2; exit 2 ;;
  esac
  mkdir -p .claude
  [ -f "$settings_path" ] || echo '{}' > "$settings_path"
  jq --arg profile "$profile_name" '
    ["guards", "token-ledger", "handoff", "adhd-style"] as $base |
    (if $profile == "coding" then ["code-style", "tdd", "quality-gates", "project-notes"]
     elif $profile == "ui" then ["code-style", "tdd", "quality-gates", "ui-design", "project-notes"]
     elif $profile == "planning" then ["brainstorm", "small-plans", "project-notes", "prompt-optimizer"]
     else ["project-notes", "tidy-notes"] end) as $extras |
    ($base + $extras) as $enabled |
    del(.enabledPlugins["ledger-tune@claude-kit"]) |
    reduce ["guards", "token-ledger", "handoff", "adhd-style", "code-style", "tdd", "quality-gates", "ui-design", "project-notes", "brainstorm", "small-plans", "prompt-optimizer", "tidy-notes"][] as $plugin
      (. ; .enabledPlugins[($plugin + "@claude-kit")] = ($enabled | index($plugin) != null)) |
    .enabledPlugins["vercel@claude-plugins-official"] = ($profile == "ui") |
    .enabledPlugins["frontend-design@claude-plugins-official"] = ($profile == "ui")
  ' "$settings_path" > "$settings_path.new" \
    || { rm -f "$settings_path.new"; fail "$PWD/$settings_path is not valid JSON; nothing was changed."; }
  mv "$settings_path.new" "$settings_path"
  echo "Wrote the $profile_name profile to $PWD/$settings_path. Start a new Claude Code session here to load it."
}

if [ "${1:-}" = "profile" ]; then
  write_profile "${2:-}"
  exit 0
fi

echo "Pulling $repository_root"
git -C "$repository_root" pull --ff-only || failed_steps+=("pull $repository_root")

if ! has_claude_kit_marketplace; then
  echo "Adding the claude-kit marketplace from $repository_root"
  claude plugin marketplace add "$repository_root"
fi

echo "Updating the claude-kit marketplace"
claude plugin marketplace update claude-kit

updated_items=()
failed_collectors=()
update_pattern='updated from ([^[:space:]]+) to ([^[:space:]]+)'
inventory="$(claude plugin list --available --json)"
while IFS=$'\t' read -r plugin_id plugin_scope project_path; do
  plugin_directory="${project_path:-$PWD}"
  if [ "$plugin_id" = "ledger-tune@claude-kit" ]; then
    for failed_collector in "${failed_collectors[@]+"${failed_collectors[@]}"}"; do
      if [ "$failed_collector" = "$plugin_scope:$plugin_directory" ]; then continue 2; fi
    done
    if ! jq -e --arg scope "$plugin_scope" --arg project "$project_path" '.installed[] | select(.id == "token-ledger@claude-kit" and .scope == $scope and (.projectPath // "") == $project)' <<<"$inventory" >/dev/null; then
      if ! (cd "$plugin_directory" && claude plugin install token-ledger@claude-kit --scope "$plugin_scope"); then
        failed_steps+=("install token-ledger in $plugin_scope scope")
        continue
      fi
      updated_items+=("installed token-ledger")
    fi
    (cd "$plugin_directory" && claude plugin uninstall "$plugin_id" --scope "$plugin_scope") || failed_steps+=("remove $plugin_id")
    continue
  fi
  if update_output="$(cd "$plugin_directory" && claude plugin update "$plugin_id" --scope "$plugin_scope" 2>&1)"; then
    if [[ "$update_output" =~ $update_pattern ]]; then
      updated_items+=("${plugin_id%@*} ${BASH_REMATCH[1]} to ${BASH_REMATCH[2]}")
      echo "Updated ${plugin_id%@*} from ${BASH_REMATCH[1]} to ${BASH_REMATCH[2]}"
    fi
  else
    echo "$update_output" >&2
    failed_steps+=("update $plugin_id")
    if [ "$plugin_id" = token-ledger@claude-kit ]; then failed_collectors+=("$plugin_scope:$plugin_directory"); fi
  fi
done < <(jq -r '.installed | sort_by(.id == "ledger-tune@claude-kit")[] | select(.id | endswith("@claude-kit")) | [.id, .scope, (.projectPath // "")] | @tsv' <<<"$inventory")

move_store_folder small-plans "small plans" SMALL_PLANS_DIR || failed_steps+=("move small plans")
move_store_folder handoffs "handoffs" HANDOFFS_DIR || failed_steps+=("move handoffs")
move_store_folder project-notes "project notes" PROJECT_NOTES_DIR || failed_steps+=("move project notes")
move_store_folder brainstorm "brainstorm" BRAINSTORM_DIR || failed_steps+=("move brainstorm")

if [ "${#updated_items[@]}" -gt 0 ]; then
  ledger_command="${CLAUDE_KIT_LEDGER_COMMAND:-$repository_root/plugins/token-ledger/bin/claude-ledger}"
  joined_items="$(IFS=', '; echo "${updated_items[*]}")"
  "$ledger_command" --fixed "claude-kit-update: $joined_items" || failed_steps+=("record the update")
fi

mkdir -p "$link_directory"
link_command "$repository_root/notes-viewer/claude-notes"
link_command "$repository_root/agent-models/claude-agent-models"
link_command "$repository_root/plugins/token-ledger/bin/claude-ledger"
link_command "$repository_root/claude-kit-update"
link_command "$repository_root/claude-kit-doctor"

if [ "${#failed_steps[@]}" -gt 0 ]; then
  printf 'Failed: %s\n' "${failed_steps[@]}" >&2
  exit 1
fi
echo "Done. Start a new Claude Code session to load the updated plugins."

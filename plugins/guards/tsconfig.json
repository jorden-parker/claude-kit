{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "typeRoots": ["./node_modules/@types", "./.claude-plugin/types"],
    "types": ["bun", "claude-code"],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["hooks"]
}

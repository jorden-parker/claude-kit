#!/usr/bin/env bash
set -euo pipefail

usage="Usage: session-notes [browse]
       session-notes list
       session-notes delete <session> <note>
       session-notes amend <session> <note> <text>
       session-notes completion zsh"

fail() {
  printf '%s\n' "$1" >&2
  exit "${2:-1}"
}

find_store() {
  if [ -n "${SESSION_NOTES_STORE:-}" ]; then
    printf '%s\n' "$SESSION_NOTES_STORE"
    return
  fi
  local store_directory="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/store"
  local store_files=()
  shopt -s nullglob
  store_files=("$store_directory"/session-notes_*.json)
  shopt -u nullglob
  if [ "${#store_files[@]}" -gt 1 ]; then
    fail "Several session-notes stores found; set SESSION_NOTES_STORE to one of:
$(printf '  %s\n' "${store_files[@]}")"
  fi
  printf '%s\n' "${store_files[0]:-$store_directory/session-notes.json}"
}

require_number() {
  [[ "$1" =~ ^[1-9][0-9]*$ ]] || fail "$usage" 2
}

list_notes() {
  jq -r --argjson only_session_index "${1:-null}" '
    (.notes // []) | to_entries
    | map(select($only_session_index == null or .key == $only_session_index)) | map(
      .key as $session_index | .value as $session |
      ["[\($session_index + 1)] \($session.startedAt[0:10]) \($session.startedAt[11:16]) UTC  \($session.cwd)"]
      + ($session.prompts | map("  > \(.)"))
      + (($session.notes // []) | to_entries | map("  note \(.key + 1) \(.value)"))
      + ($session.files | map("  edited \(.)"))
      + ($session.commands | map("  $ \(.)"))
      | join("\n")
    ) | join("\n\n")
  ' "$store_path"
}

replace_note() {
  local session_number="$1" note_number="$2" replacement_json="$3"
  local session_index=$((session_number - 1)) note_index=$((note_number - 1))
  jq -e --argjson session_index "$session_index" '.notes[$session_index] != null' \
    "$store_path" > /dev/null || fail "No session $session_number."
  jq -e --argjson session_index "$session_index" --argjson note_index "$note_index" \
    '(.notes[$session_index].notes // [])[$note_index] != null' \
    "$store_path" > /dev/null || fail "No note $note_number in session $session_number."
  local updated_store
  updated_store="$(mktemp "$store_path.XXXXXX")"
  jq --argjson session_index "$session_index" --argjson note_index "$note_index" \
    --argjson replacement "$replacement_json" \
    '.notes[$session_index].notes |= (.[:$note_index] + $replacement + .[$note_index + 1:])' \
    "$store_path" > "$updated_store"
  mv "$updated_store" "$store_path"
}

load_note_rows() {
  note_rows=()
  local note_row
  while IFS= read -r note_row; do
    note_rows+=("$note_row")
  done < <(jq -r '
    (.notes // []) | to_entries[] | .key as $session_index | .value as $session
    | ($session.notes // []) | to_entries[]
    | "\($session_index + 1)\t\(.key + 1)\t\($session.startedAt[0:10])  \($session.cwd | split("/") | last)  \(.value | gsub("[\t\n]"; " "))"
  ' "$store_path")
}

read_key() {
  local key escape_sequence
  if ! IFS= read -rsn1 key; then
    pressed_key=quit
    return
  fi
  case "$key" in
    $'\e')
      IFS= read -rsn2 -t 1 escape_sequence || true
      case "$escape_sequence" in
        '[A') pressed_key=up ;;
        '[B') pressed_key=down ;;
        '') pressed_key=quit ;;
        *) pressed_key=none ;;
      esac
      ;;
    k) pressed_key=up ;;
    j) pressed_key=down ;;
    '' | v) pressed_key=view ;;
    e) pressed_key=edit ;;
    d) pressed_key=delete ;;
    q) pressed_key=quit ;;
    *) pressed_key=none ;;
  esac
}

enter_full_screen() {
  printf '\033[?1049h\033[?25l'
}

leave_full_screen() {
  printf '\033[?1049l\033[?25h'
}

draw_note_list() {
  local columns lines visible_row_count row_index note_display
  columns="$(tput cols 2> /dev/null || echo 80)"
  lines="$(tput lines 2> /dev/null || echo 24)"
  visible_row_count=$((lines > 5 ? lines - 4 : 1))
  if [ "$selected_index" -lt "$first_visible_index" ]; then
    first_visible_index="$selected_index"
  elif [ "$selected_index" -ge $((first_visible_index + visible_row_count)) ]; then
    first_visible_index=$((selected_index - visible_row_count + 1))
  fi
  printf '\033[H\033[2J\033[1mSession notes\033[0m  %d notes\n\n' "${#note_rows[@]}"
  for ((row_index = first_visible_index; row_index < ${#note_rows[@]} && row_index < first_visible_index + visible_row_count; row_index++)); do
    note_display="${note_rows[row_index]#*$'\t'*$'\t'}"
    note_display="${note_display:0:columns-2}"
    if [ "$row_index" -eq "$selected_index" ]; then
      printf '\033[7m> %s\033[0m\n' "$note_display"
    else
      printf '  %s\n' "$note_display"
    fi
  done
  printf '\n\033[2m↑/↓ move  enter view  e edit  d delete  q quit\033[0m'
}

edit_note() {
  local session_number="$1" note_number="$2" note_file note_text
  note_file="$(mktemp -t session-note.XXXXXX)"
  jq -r --argjson session_index $((session_number - 1)) --argjson note_index $((note_number - 1)) \
    '.notes[$session_index].notes[$note_index]' "$store_path" > "$note_file"
  leave_full_screen
  # shellcheck disable=SC2086
  ${VISUAL:-${EDITOR:-vi}} "$note_file"
  enter_full_screen
  note_text="$(tr '\n' ' ' < "$note_file" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  rm -f "$note_file"
  [ -n "$note_text" ] || return 0
  replace_note "$session_number" "$note_number" "$(jq -cn --arg text "${note_text:0:500}" '[$text]')"
}

browse_notes() {
  load_note_rows
  if [ "${#note_rows[@]}" -eq 0 ]; then
    printf 'No notes to browse.\n'
    return
  fi
  selected_index=0
  first_visible_index=0
  enter_full_screen
  trap leave_full_screen EXIT
  local session_number note_number confirmation
  while [ "${#note_rows[@]}" -gt 0 ]; do
    draw_note_list
    read_key
    session_number="${note_rows[selected_index]%%$'\t'*}"
    note_number="${note_rows[selected_index]#*$'\t'}"
    note_number="${note_number%%$'\t'*}"
    case "$pressed_key" in
      up) [ "$selected_index" -eq 0 ] || selected_index=$((selected_index - 1)) ;;
      down) [ "$selected_index" -ge $((${#note_rows[@]} - 1)) ] || selected_index=$((selected_index + 1)) ;;
      view) list_notes $((session_number - 1)) | less ;;
      edit) edit_note "$session_number" "$note_number" ;;
      delete)
        printf '\r\033[K\033[1mDelete this note? [y/N]\033[0m '
        IFS= read -rsn1 confirmation || confirmation=n
        if [ "$confirmation" = y ] || [ "$confirmation" = Y ]; then
          replace_note "$session_number" "$note_number" '[]'
        fi
        ;;
      quit) break ;;
    esac
    load_note_rows
    [ "$selected_index" -lt "${#note_rows[@]}" ] || selected_index=$((${#note_rows[@]} - 1))
  done
}

print_zsh_completion() {
  cat <<'ZSH'
_session_notes() {
  local -a candidates
  local subcommand=$words[2]
  case $CURRENT in
    2)
      candidates=(
        'browse:pick a note to view, edit or delete'
        'list:list every session and its notes'
        'delete:delete a note'
        'amend:replace the text of a note'
        'completion:print the shell completion script'
      )
      _describe command candidates
      ;;
    3)
      case $subcommand in
        delete|amend)
          candidates=(${(f)"$(session-notes list 2>/dev/null | awk '
            /^\[[0-9]+\] / { current_session = substr($1, 2, length($1) - 2); next }
            $1 == "note" {
              number = $2
              sub(/^ *note [0-9]+ /, "")
              gsub(/:/, "\\:")
              print current_session " " number ":" $0
            }')"})
          _describe note candidates -Q
          ;;
        completion)
          candidates=(zsh)
          _describe shell candidates
          ;;
      esac
      ;;
    4)
      case $subcommand in
        delete|amend)
          candidates=(${(f)"$(session-notes list 2>/dev/null | awk -v session="$words[3]" '
            /^\[[0-9]+\] / { current_session = substr($1, 2, length($1) - 2); next }
            current_session == session && $1 == "note" {
              number = $2
              sub(/^ *note [0-9]+ /, "")
              gsub(/:/, "\\:")
              print number ":" $0
            }')"})
          _describe note candidates
          ;;
      esac
      ;;
  esac
}
(( $+functions[compdef] )) || { autoload -Uz compinit && compinit; }
compdef _session_notes session-notes
ZSH
}

if [ "$#" -eq 0 ]; then
  [ -t 0 ] && [ -t 1 ] || fail "$usage" 2
  set -- browse
fi

if [ "$1" = "completion" ]; then
  [ "$#" -eq 2 ] && [ "$2" = "zsh" ] || fail "$usage" 2
  print_zsh_completion
  exit 0
fi

store_path="$(find_store)"
[ -f "$store_path" ] || fail "No session notes yet."

case "$1" in
  browse)
    [ "$#" -eq 1 ] || fail "$usage" 2
    browse_notes
    ;;
  list)
    [ "$#" -eq 1 ] || fail "$usage" 2
    list_notes
    ;;
  delete)
    [ "$#" -eq 3 ] || fail "$usage" 2
    require_number "$2"
    require_number "$3"
    replace_note "$2" "$3" '[]'
    printf 'Deleted note %s from session %s.\n' "$3" "$2"
    ;;
  amend)
    [ "$#" -ge 4 ] || fail "$usage" 2
    require_number "$2"
    require_number "$3"
    session_number="$2" note_number="$3"
    shift 3
    note_text="$(printf '%s' "$*" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [ -n "$note_text" ] || fail "The note needs some text."
    replace_note "$session_number" "$note_number" "$(jq -cn --arg text "${note_text:0:500}" '[$text]')"
    printf 'Amended note %s in session %s.\n' "$note_number" "$session_number"
    ;;
  *)
    fail "$usage" 2
    ;;
esac

#!/usr/bin/env bash
set -euo pipefail

usage="Usage: session-notes [browse]
       session-notes list
       session-notes delete <session> <note>
       session-notes amend <session> <note> <text>
       session-notes completion zsh"

fail() {
  printf '%s\n' "$1" >&2
  exit "${2:-1}"
}

find_store() {
  if [ -n "${SESSION_NOTES_STORE:-}" ]; then
    printf '%s\n' "$SESSION_NOTES_STORE"
    return
  fi
  local store_directory="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/store"
  local store_files=()
  shopt -s nullglob
  store_files=("$store_directory"/session-notes_*.json)
  shopt -u nullglob
  if [ "${#store_files[@]}" -gt 1 ]; then
    fail "Several session-notes stores found; set SESSION_NOTES_STORE to one of:
$(printf '  %s\n' "${store_files[@]}")"
  fi
  printf '%s\n' "${store_files[0]:-$store_directory/session-notes.json}"
}

require_number() {
  [[ "$1" =~ ^[1-9][0-9]*$ ]] || fail "$usage" 2
}

list_notes() {
  jq -r '
    (.notes // []) | to_entries | map(
      .key as $session_index | .value as $session |
      ($session.startedAt // "") as $started_at |
      ["[\($session_index + 1)] \($started_at[0:10]) \($started_at[11:16]) UTC · \($session.cwd // "")"]
      + (($session.notes // []) | to_entries | map(
          "  note \(.key + 1) " as $prefix |
          (if (.value | type) == "string" then .value else (.value | tojson) end | split("\n")) as $lines |
          $prefix + $lines[0] + ($lines[1:] | map("\n" + (" " * ($prefix | length)) + .) | join(""))
        ))
      | join("\n")
    ) | join("\n\n")
  ' "$store_path"
}

replace_note() {
  local session_number="$1" note_number="$2" replacement_json="$3"
  local session_index=$((session_number - 1)) note_index=$((note_number - 1))
  jq -e --argjson session_index "$session_index" '.notes[$session_index] != null' \
    "$store_path" > /dev/null || fail "No session $session_number."
  jq -e --argjson session_index "$session_index" --argjson note_index "$note_index" \
    '(.notes[$session_index].notes // [])[$note_index] != null' \
    "$store_path" > /dev/null || fail "No note $note_number in session $session_number."
  local updated_store
  updated_store="$(mktemp "$store_path.XXXXXX")"
  jq --argjson session_index "$session_index" --argjson note_index "$note_index" \
    --argjson replacement "$replacement_json" \
    '.notes[$session_index].notes |= (.[:$note_index] + $replacement + .[$note_index + 1:])' \
    "$store_path" > "$updated_store"
  mv "$updated_store" "$store_path"
}

browse_notes() {
  local script_path="$0" tui_directory browser_path
  [ ! -L "$script_path" ] || script_path="$(readlink "$script_path")"
  tui_directory="$(cd "$(dirname "$script_path")/../tui" && pwd)"
  browser_path="${XDG_CACHE_HOME:-$HOME/.cache}/session-notes/browse-$(printf '%s' "$tui_directory" | cksum | cut -d ' ' -f 1)"
  if [ ! -x "$browser_path" ] || [ -n "$(find "$tui_directory" -newer "$browser_path" -print -quit)" ]; then
    command -v go > /dev/null || fail "Browsing needs Go once, to build the browser. Install it (brew install go) and run session-notes again."
    [ ! -t 2 ] || printf 'Building the session-notes browser...\n' >&2
    (cd "$tui_directory" && go build -o "$browser_path" .) || fail "Could not build the session-notes browser."
  fi
  SESSION_NOTES_STORE="$store_path" exec "$browser_path"
}

print_zsh_completion() {
  cat <<'ZSH'
_session_notes() {
  local -a candidates
  local subcommand=$words[2]
  case $CURRENT in
    2)
      candidates=(
        'browse:pick a note to view, edit or delete'
        'list:list every session and its notes'
        'delete:delete a note'
        'amend:replace the text of a note'
        'completion:print the shell completion script'
      )
      _describe command candidates
      ;;
    3)
      case $subcommand in
        delete|amend)
          candidates=(${(f)"$(session-notes list 2>/dev/null | awk '
            /^\[[0-9]+\] / { current_session = substr($1, 2, length($1) - 2); next }
            /^  note [0-9]+ / {
              number = $2
              sub(/^ *note [0-9]+ /, "")
              gsub(/:/, "\\:")
              print current_session " " number ":" $0
            }')"})
          _describe note candidates -Q
          ;;
        completion)
          candidates=(zsh)
          _describe shell candidates
          ;;
      esac
      ;;
    4)
      case $subcommand in
        delete|amend)
          candidates=(${(f)"$(session-notes list 2>/dev/null | awk -v session="$words[3]" '
            /^\[[0-9]+\] / { current_session = substr($1, 2, length($1) - 2); next }
            current_session == session && /^  note [0-9]+ / {
              number = $2
              sub(/^ *note [0-9]+ /, "")
              gsub(/:/, "\\:")
              print number ":" $0
            }')"})
          _describe note candidates
          ;;
      esac
      ;;
  esac
}
(( $+functions[compdef] )) || { autoload -Uz compinit && compinit; }
compdef _session_notes session-notes
ZSH
}

if [ "$#" -eq 0 ]; then
  [ -t 0 ] && [ -t 1 ] || fail "$usage" 2
  set -- browse
fi

if [ "$1" = "completion" ]; then
  [ "$#" -eq 2 ] && [ "$2" = "zsh" ] || fail "$usage" 2
  print_zsh_completion
  exit 0
fi

store_path="$(find_store)"
[ -f "$store_path" ] || fail "No session notes yet."

case "$1" in
  browse)
    [ "$#" -eq 1 ] || fail "$usage" 2
    browse_notes
    ;;
  list)
    [ "$#" -eq 1 ] || fail "$usage" 2
    list_notes
    ;;
  delete)
    [ "$#" -eq 3 ] || fail "$usage" 2
    require_number "$2"
    require_number "$3"
    replace_note "$2" "$3" '[]'
    printf 'Deleted note %s from session %s.\n' "$3" "$2"
    ;;
  amend)
    [ "$#" -ge 4 ] || fail "$usage" 2
    require_number "$2"
    require_number "$3"
    session_number="$2" note_number="$3"
    shift 3
    note_text="$(printf '%s' "$*" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [ -n "$note_text" ] || fail "The note needs some text."
    replace_note "$session_number" "$note_number" "$(jq -cn --arg text "${note_text:0:500}" '[$text]')"
    printf 'Amended note %s in session %s.\n' "$note_number" "$session_number"
    ;;
  *)
    fail "$usage" 2
    ;;
esac

#!/usr/bin/env bash
set -euo pipefail

script_path="$(realpath "$0")"
plugin_folder="$(dirname "$(dirname "$script_path")")"
case "${1:-}" in
  diagnose) exec bun "$plugin_folder/hooks/run.ts" diagnose ;;
  analyze) shift; exec bun "$plugin_folder/hooks/run.ts" analyze "$@" ;;
  verify)
    shift
    if [ "$#" -eq 1 ] && [ "$1" = browser ]; then exec bun "$plugin_folder/hooks/run.ts" browser-verify; fi
    if [ "$#" -eq 0 ]; then exec bun "$plugin_folder/hooks/run.ts" compact-verify; fi
    if [ "$#" -eq 1 ] && [ "$1" = all ]; then exec bun "$plugin_folder/hooks/run.ts" verify; fi
    if [ "$#" -eq 2 ] && [ "$1" = since ] && [[ "$2" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
      exec bun "$plugin_folder/hooks/run.ts" compact-verify "$2"
    fi
    echo "Usage: claude-ledger verify [browser | all | since YYYY-MM-DD]" >&2
    exit 2 ;;
esac
if [ "${1:-}" = "--checkins" ]; then
  exec bun "$plugin_folder/hooks/run.ts" checkins
fi
if [ "${1:-}" = "--text" ]; then
  shift
  exec bun "$plugin_folder/hooks/run.ts" report "$@"
fi
if [ "${1:-}" = "--fixed" ]; then
  exec bun "$plugin_folder/hooks/run.ts" fixed "${2-}"
fi
if [ "${1:-}" = "--verify" ]; then
  if [ $# -ge 2 ]; then
    exec bun "$plugin_folder/hooks/run.ts" verify "$2"
  fi
  exec bun "$plugin_folder/hooks/run.ts" verify
fi
exec bun "$plugin_folder/hooks/run.ts" table "$@"

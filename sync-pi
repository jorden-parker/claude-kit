#!/usr/bin/env bash
set -euo pipefail

usage="Usage: ./sync-pi [--local] [plugin...]
Installs this repo's plugins into pi as local packages: register.ts modules and Claude Code command hooks. Run it again after changes.
Without arguments it syncs every plugin under plugins/. PI_CODING_AGENT_DIR overrides ~/.pi/agent.
--local installs into the current folder's .pi/settings.json instead, for that project only."

source "$(dirname "$0")/plugin-host/sync-lib.sh"
exit_after_usage_request "$usage" "${1:-}"

install_options=()
installed_where="installed."
package_root="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/claude-kit"
if [ "${1:-}" = "--local" ]; then
  shift
  install_options=(-l --approve)
  installed_where="installed in this project."
  package_root="$(pwd -P)/.pi/claude-kit"
  mkdir -p "$package_root"
  echo "claude-kit/" > "$package_root/../.gitignore"
fi
failed_plugins=()

sync_plugin() {
  local plugin_folder="${1%/}" plugin_name package_folder
  plugin_name="$(read_plugin_name "$plugin_folder")"
  package_folder="$package_root/$plugin_name"

  if ! uses_module_api "$plugin_folder" && ! uses_command_hooks "$plugin_folder"; then
    echo "$plugin_name: skipped. It has no register.ts module or Claude Code command hooks, and pi has no output styles"
    return 0
  fi

  if ! stage_plugin pi "$plugin_folder" "$package_folder" || ! pi install "$package_folder" ${install_options[@]+"${install_options[@]}"} >/dev/null; then
    echo "$plugin_name: FAILED to install"
    failed_plugins+=("$plugin_name")
    return 0
  fi

  local hooks_note=""
  if [ -f "$package_folder/pi-hooks-extension.js" ]; then
    hooks_note=". Its command hooks run in a second pi extension, minus the events pi cannot run (see the README)"
  fi
  if [ -f "$package_folder/plugin-host-extension.js" ]; then
    echo "$plugin_name: $installed_where Its tools run in a pi extension and its slash commands as prompt templates; panes, autocomplete, composer fill and subagents stay in Claude Code$hooks_note"
  elif [ -n "$hooks_note" ]; then
    echo "$plugin_name: $installed_where Its command hooks run in a pi extension, minus the events pi cannot run (see the README)."
  else
    echo "$plugin_name: $installed_where Its slash commands run as prompt templates in pi"
  fi
}

require_commands pi jq rsync bun node
select_plugin_folders "$@"
for plugin_folder in "${plugin_folders[@]}"; do sync_plugin "$plugin_folder"; done
report_failed_plugins ${failed_plugins[@]+"${failed_plugins[@]}"}

#!/usr/bin/env bash
set -euo pipefail

usage="Usage: ./sync-qwen [plugin...]
Installs this repo's plugins into Qwen Code, replacing earlier syncs. Run it again after changes.
Without arguments it syncs every plugin under plugins/. QWEN_HOME overrides ~/.qwen."

source "$(dirname "$0")/plugin-host/sync-lib.sh"
exit_after_usage_request "$usage" "${1:-}"

qwen_home="${QWEN_HOME:-$HOME/.qwen}"
staging_root="$qwen_home/claude-kit"
failed_plugins=()

has_qwen_loadable_parts() {
  [ -f "$1/hooks/hooks.json" ] || [ -d "$1/skills" ] || [ -d "$1/agents" ] ||
    [ -d "$1/commands" ] || [ -f "$1/.mcp.json" ]
}

remove_earlier_install() {
  [ -d "$qwen_home/extensions/$1" ] && qwen extensions uninstall "$1" >/dev/null
  return 0
}

install_plugin() {
  local plugin_folder="$1" plugin_name="$2" staged_folder="$3"
  if ! stage_plugin qwen "$plugin_folder" "$staged_folder"; then return 1; fi
  remove_earlier_install "$plugin_name"
  qwen extensions install "$staged_folder" --consent >/dev/null
}

sync_plugin() {
  local plugin_folder="${1%/}" plugin_name staged_folder
  plugin_name="$(read_plugin_name "$plugin_folder")"
  staged_folder="$staging_root/$plugin_name"

  if [ -d "$plugin_folder/output-styles" ]; then
    mkdir -p "$qwen_home/output-styles"
    cp "$plugin_folder"/output-styles/*.md "$qwen_home/output-styles/"
    echo "$plugin_name: output style copied to $qwen_home/output-styles; pick it with /output-style"
  fi

  if ! has_qwen_loadable_parts "$plugin_folder"; then
    remove_earlier_install "$plugin_name"
    return 0
  fi

  if ! install_plugin "$plugin_folder" "$plugin_name" "$staged_folder"; then
    echo "$plugin_name: FAILED to install"
    failed_plugins+=("$plugin_name")
    return 0
  fi

  if [ -f "$staged_folder/.mcp.json" ]; then
    echo "$plugin_name: installed. Its tools and slash commands run through an MCP server; panes, autocomplete and composer fill stay in Claude Code"
  elif uses_module_api "$plugin_folder"; then
    echo "$plugin_name: installed. Its slash commands run as prompts in Qwen Code"
  elif grep -rqs transcript_path "$plugin_folder/hooks"; then
    echo "$plugin_name: installed. Warning: some hooks read Claude Code's transcript format and may never block in Qwen Code"
  else
    echo "$plugin_name: installed"
  fi
}

require_commands qwen jq rsync bun node
select_plugin_folders "$@"
for plugin_folder in "${plugin_folders[@]}"; do sync_plugin "$plugin_folder"; done
rm -rf "$staging_root"
report_failed_plugins ${failed_plugins[@]+"${failed_plugins[@]}"}
